{
  "version": 1,
  "defaultRole": "chat-only",
  "roles": {
    "owner": {
      "description": "Full access and permission.",
      "permissions": [
        "all"
      ]
    },
    "trusted": {
      "description": "Work-related help within constrained scope.",
      "permissions": [
        "conversation",
        "engineering_help",
        "product_help",
        "qa_help",
        "incident_help"
      ],
      "denies": [
        "change_skills",
        "change_tools_notes",
        "change_internal_tooling",
        "change_policy_files",
        "request_workspace_backups",
        "change_configuration",
        "change_gateway_configuration",
        "access_owner_only_config",
        "access_memory_files_unless_strictly_required",
        "access_secrets",
        "access_credentials",
        "access_personal_email",
        "access_personal_calendar",
        "access_private_docs_unrelated_to_engineering"
      ]
    },
    "chat-only": {
      "description": "Basic conversation only.",
      "permissions": [
        "conversation"
      ],
      "denies": [
        "tool_use",
        "file_reads",
        "repository_access",
        "github_access",
        "linear_access",
        "memory_disclosure",
        "private_context_disclosure",
        "change_configuration",
        "external_actions",
        "request_workspace_backups"
      ]
    },
    "blocked": {
      "description": "No access or permissions at all.",
      "permissions": [],
      "denies": [
        "all"
      ]
    }
  },
