      "chat-only": "deny",
      "blocked": "deny"
    },
    "use_metabase_core_loans": {
      "owner": "allow",
      "trusted": "allow_if_work_related_read_only",
      "chat-only": "deny",
      "blocked": "deny"
    },
    "change_configuration": {
      "owner": "allow",
      "trusted": "deny",
      "chat-only": "deny",
      "blocked": "deny"
    },
    "change_gateway_configuration": {
      "owner": "allow",
