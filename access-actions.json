      "chat-only": "deny",
      "blocked": "deny"
    },
    "change_tools_notes": {
      "owner": "allow",
      "trusted": "deny",
      "chat-only": "deny",
      "blocked": "deny"
    },
    "run_shell_commands": {
      "owner": "allow",
      "trusted": "allow_if_work_related_and_not_protected",
