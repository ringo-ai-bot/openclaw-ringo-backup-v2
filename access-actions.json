{
  "version": 1,
  "defaultRole": "chat-only",
  "identity": {
    "authoritativeKey": "slackMemberId",
    "fallbacks": [
      "exactName"
    ],
    "fallbackPolicy": {
      "conversation": true,
      "lowRiskRead": false,
      "privilegedActions": false
    },
    "unknownIdentityRole": "chat-only",
    "ambiguousIdentityRole": "chat-only"
  },
  "actions": {
    "basic_conversation": {
      "owner": "allow",
      "trusted": "allow",
      "chat-only": "allow",
      "blocked": "deny"
    },
    "read_engineering_context": {
      "owner": "allow",
      "trusted": "allow",
      "chat-only": "deny",
      "blocked": "deny"
    },
    "read_repository": {
      "owner": "allow",
      "trusted": "allow",
      "chat-only": "deny",
      "blocked": "deny"
    },
    "read_workspace_files": {
      "owner": "allow",
      "trusted": "allow_if_work_related",
      "chat-only": "deny",
      "blocked": "deny"
    },
    "edit_workspace_files": {
      "owner": "allow",
      "trusted": "allow_if_work_related_and_not_protected",
      "chat-only": "deny",
      "blocked": "deny"
    },
    "read_memory_files": {
      "owner": "allow",
      "trusted": "allow_if_strictly_required_for_engineering_task",
      "chat-only": "deny",
