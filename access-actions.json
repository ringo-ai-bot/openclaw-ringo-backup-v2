  "protectedPaths": [
    "SOUL.md",
    "AGENTS.md",
    "TOOLS.md",
    "MEMORY.md",
    "ACCESS_POLICY.md",
    "access-control.json",
    "access-actions.json"
  ],
  "notes": [
    "Slack member ID should become the authoritative identity key once available.",
    "Exact-name fallback is only acceptable for conversation, not privileged actions.",
    "Trusted users may work on engineering tasks but must not modify protected policy/governance/internal files.",
    "The metabase-core-loans helper may use its configured credential for authorized read-only queries, but the credential must never be disclosed to Trusted users."
  ]
